# KeeperHub Copilot — the settings the app reads (lib/config.ts).
# Copy to .env.local and fill in. Settings with defaults
# (OPENAI_CHAT_MODEL, KEEPERHUB_MCP_URL, KEEPERHUB_URL) are left out.

# Sign-in: an OAuth client registered with KeeperHub for THIS app's address.
# The callback must be exactly <APP_BASE_URL>/api/auth/callback.
KEEPERHUB_OAUTH_ISSUER=https://app.keeperhub.com
KEEPERHUB_OAUTH_CLIENT_ID=
KEEPERHUB_OAUTH_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3001

# Conversations and the activity record (Postgres).
DATABASE_URL=

# The assistant, and the secrets that seal sessions and approvals.
# Each secret needs at least 32 characters.
OPENAI_API_KEY=
SESSION_SECRET=
TOOL_APPROVAL_SECRET=
