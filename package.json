{
  "name": "keeperhub-copilot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify": "node --conditions react-server --env-file-if-exists=.env.local scripts/verify-db.ts",
    "registry:generate": "node scripts/generate-registry.ts",
    "registry:check": "node scripts/generate-registry.ts && git diff --exit-code -- lib/registry/generated/"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.37",
    "@ai-sdk/react": "~4.0.62",
    "@base-ui/react": "^1.8.0",
    "@dicebear/core": "^9.4.3",
    "@dicebear/identicon": "^9.4.2",
    "@neondatabase/serverless": "^1.1.0",
    "@openai/agents": "^0.18.0",
    "ai": "~7.0.59",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.548.0",
    "motion": "^13.2.0",
    "next": "16.3.0",
    "next-intl": "^4.14.5",
    "qrcode.react": "^4.2.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^3"
  }
}
